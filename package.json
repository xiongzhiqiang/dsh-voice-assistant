{
	"name": "dsh-voice-assistant",
	"version": "1.3.1",
	"description": "「小凤」always-on voice assistant for DeepSeek Harness: wake-word standby, speech transcription with LLM polish, voice-driven multi-turn session dialogue, spoken replies, and a 60s idle-sleep cycle that wakes on a chime or an incoming agent message.",
	"type": "module",
	"main": "index.js",
	"exports": {
		".": {
			"default": "./index.js"
		},
		"./client": {
			"default": "./lib/client.js"
		},
		"./lib/*": "./lib/*",
		"./package.json": "./package.json"
	},
	"keywords": [
		"dsh",
		"deepseek-harness",
		"voice",
		"speech",
		"wake-word",
		"tts",
		"asr",
		"cordis"
	],
	"license": "MIT",
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"inject": [
				"@deepseek-ai/dsh-api-remotes/client",
				"@deepseek-ai/dsh-api-session-controller",
				"@deepseek-ai/dsh-client-ui-renderer",
				"@deepseek-ai/dsh-client-ui-session",
				"@deepseek-ai/dsh-client-ui-workspace"
			],
			"platform": "web"
		}
	},
	"peerDependencies": {
		"@deepseek-ai/dsh-host-webserver": ">=0.2.2-rc.1 <0.3.0"
	},
	"files": [
		"index.js",
		"lib/",
		"cordis.patch.yml",
		"README.md"
	],
	"scripts": {
		"build": "node build.mjs",
		"check": "node build.mjs --check",
		"test": "node --test tests/host.test.mjs tests/client-core.test.mjs tests/questions.test.mjs",
		"check:sessions": "node tools/check-session-integrity.mjs",
		"verify": "node tools/check-session-integrity.mjs && node tools/smoke-host.mjs && node tools/smoke-agent-route.mjs"
	}
}
